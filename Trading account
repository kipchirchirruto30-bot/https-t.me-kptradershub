  <!-- JavaScript: draw a realistic candlestick/line chart on canvas -->
  <script>
    (function() {
      const canvas = document.getElementById('priceChart');
      if (!canvas) return;
      
      // set canvas resolution for crispness
      function resizeCanvas() {
        const container = canvas.parentElement;
        const dpr = window.devicePixelRatio || 1;
        const rect = container.getBoundingClientRect();
        canvas.width = rect.width * dpr;
        canvas.height = rect.height * dpr;
        const ctx = canvas.getContext('2d');
        ctx.scale(dpr, dpr);
        drawChart();
      }

      function drawChart() {
        const container = canvas.parentElement;
        const w = container.clientWidth;
        const h = container.clientHeight;
        if (w === 0 || h === 0) return;

        const ctx = canvas.getContext('2d');
        ctx.clearRect(0, 0, w, h);

        // background grid (subtle)
        ctx.strokeStyle = '#1a222c';
        ctx.lineWidth = 0.6;
        for (let i = 0; i <= 6; i++) {
          const y = (h / 6) * i;
          ctx.beginPath();
          ctx.moveTo(0, y);
          ctx.lineTo(w, y);
          ctx.strokeStyle = '#1a222c';
          ctx.stroke();
        }

        // fake price data for a realistic line chart + some candlesticks
        const dataPoints = 42;
        const prices = [];
        let base = 67200;
        for (let i = 0; i < dataPoints; i++) {
          // random walk with slight upward trend
          const change = (Math.random() - 0.48) * 220;
          base += change;
          // clamp
          if (base < 66400) base = 66400;
          if (base > 68000) base = 68000;
          prices.push(base);
        }

        // find min/max
        const minPrice = Math.min(...prices) - 30;
        const maxPrice = Math.max(...prices) + 30;
        const range = maxPrice - minPrice;

        function getY(price) {
          return h - ((price - minPrice) / range) * h;
        }

        function getX(index) {
          return (index / (dataPoints - 1)) * w;
        }

        // draw a smooth line
        ctx.beginPath();
        ctx.strokeStyle = '#f0b90b';
        ctx.lineWidth = 2.2;
        ctx.shadowColor = 'rgba(240, 185, 11, 0.3)';
        ctx.shadowBlur = 10;
        for (let i = 0; i < dataPoints; i++) {
          const x = getX(i);
          const y = getY(prices[i]);
          if (i === 0) ctx.moveTo(x, y);
          else ctx.lineTo(x, y);
        }
        ctx.stroke();
        ctx.shadowBlur = 0;

        // fill under the line
        ctx.beginPath();
        ctx.moveTo(0, h);
        for (let i = 0; i < dataPoints; i++) {
          const x = getX(i);
          const y = getY(prices[i]);
          ctx.lineTo(x, y);
        }
        ctx.lineTo(w, h);
        ctx.closePath();
        ctx.fillStyle = 'rgba(240, 185, 11, 0.08)';
        ctx.fill();

        // draw some small candlestick-like markers (as per realism)
        for (let i = 1; i < dataPoints; i += 2) {
          const x = getX(i);
          const priceOpen = prices[i-1];
          const priceClose = prices[i];
          const high = Math.max(priceOpen, priceClose) + (Math.random() * 18);
          const low = Math.min(priceOpen, priceClose) - (Math.random() * 18);
          const yHigh = getY(high);
          const yLow = getY(low);
          const yOpen = getY(priceOpen);
          const yClose = getY(priceClose);
          const isGreen = priceClose >= priceOpen;
          ctx.fillStyle = isGreen ? '#0ecb81' : '#f6465d';
          ctx.strokeStyle = isGreen ? '#0ecb81' : '#f6465d';
          ctx.lineWidth = 1;
          // wick
          ctx.beginPath();
          ctx.moveTo(x, yHigh);
          ctx.lineTo(x, yLow);
          ctx.stroke();
          // body
          const bodyWidth = 5;
          const bodyTop = Math.min(yOpen, yClose);
          const bodyBottom = Math.max(yOpen, yClose);
          ctx.fillRect(x - bodyWidth/2, bodyTop, bodyWidth, bodyBottom - bodyTop);
        }

        // draw last price dot
        const lastX = getX(dataPoints - 1);
        const lastY = getY(prices[dataPoints - 1]);
        ctx.beginPath();
        ctx.arc(lastX, lastY, 5, 0, Math.PI * 2);
        ctx.fillStyle = '#f0b90b';
        ctx.shadowColor = '#f0b90b';
        ctx.shadowBlur = 12;
        ctx.fill();
        ctx.shadowBlur = 0;

        // small label
        ctx.font = '10px "JetBrains Mono", monospace';
        ctx.fillStyle = '#c4d0de';
        ctx.fillText('$67,432', w - 70, lastY - 10);
      }

      // initial draw
      resizeCanvas();

      // redraw on window resize
      window.addEventListener('resize', () => {
        resizeCanvas();
      });

      // optional: slight animation every few seconds (simulate live)
      setInterval(() => {
        drawChart(); // redraw with new random data (quick flicker)
      }, 4000);
    })();
  </script>
</body>
</html>
